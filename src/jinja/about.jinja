<!-- about.jinja -->
<article class="about  active" data-page="about">

  <header>
    <h2 class="h2 article-title">About me</h2>
  </header>

  <section class="about-text">

    {% for line in about.presentation.split('\n') %}
    {% if line.strip() %}
    <p>{{ line }}</p>
    {% endif %}
    {% endfor %}

  </section>


  <!--
          - service
        -->

  <section class="service">

    <h3 class="h3 service-title">Key Competencies</h3>

    <ul class="service-list">
      {% for do in doing %}

      <li class="service-item">

        <div class="service-icon-box">
          <img src="{{do.icon}}" alt="design icon" width="60" height="60">
        </div>

        <div class="service-content-box">
          <h4 class="h4 service-item-title">{{do.title}}</h4>

          
            {{do.text}}
          </p>
        </div>

      </li>

      {% endfor %}

    </ul>

  </section>


  <!--
          - testimonials
        -->
  {% if softskills.enabled %}
  <section class="testimonials">

    <h3 class="h3 testimonials-title">{{softskills.title}}</h3>

    <ul class="testimonials-list has-scrollbar">
      {% for skill in softskills.skills %}

      <li class="testimonials-item">
        <div class="content-card" data-testimonials-item>

          <figure class="testimonials-avatar-box">
            <img src="{{skill.icon}}" alt="{{skill.title}}" width="60" data-testimonials-avatar>
          </figure>

          <h4 class="h4 testimonials-item-title" data-testimonials-title>{{skill.title}}</h4>

          <div class="testimonials-text" data-testimonials-text>
            <p>
              {{skill.text}}
            </p>
          </div>

        </div>
      </li>

      {% endfor %}

      </ul>

  </section>



  <!--
          - testimonials modal
        -->

  <div class="modal-container" data-modal-container>

    <div class="overlay" data-overlay></div>

    <section class="testimonials-modal">

      <button class="modal-close-btn" data-modal-close-btn>
        <ion-icon name="close-outline"></ion-icon>
      </button>

      <div class="modal-img-wrapper">
        <figure class="modal-avatar-box">
          <img src="./src/images/avatar-1.png" alt="{{about.name}}" width="80" data-modal-img>
        </figure>

        <img src="./src/images/icon-quote.svg" alt="quote icon">
      </div>

      <div class="modal-content">

        <h4 class="h3 modal-title" data-modal-title>{{about.name}}</h4>

        {# <time datetime="2021-06-14">14 June, 2021</time> #}

        <div data-modal-text>
          <p>
            {# lorem #}
          </p>
        </div>

      </div>

    </section>

  </div>
  {% endif %}

<!--
  - Professional Skills Breakdown (NEW SECTION - REPLACES OLD CLIENTS)
-->
{% if technologies.enabled %}
<section class="tech-skills">

  <h3 class="h3 service-title">{{ technologies.title }}</h3>

  <div class="skills-grid">
    {% for category in technologies.categories %}
    <div class="skill-category">
      <div class="category-header" style="background: {{ category.color }};">
        {{ category.name }}
      </div>
      
      {% for section in category.sections %}
      <div class="skill-section">
        <div class="section-title">{{ section.title }}</div>
        
        {% if section.columns %}
          {% if section.columns == 2 %}
          <div class="skill-columns two-col">
            {% for i in range(0, section.skills|length, 2) %}
            <div class="skill-col">
              {% if section.skills[i] %}{{ section.skills[i] }}<br>{% endif %}
            </div>
            <div class="skill-col">
              {% if i + 1 < section.skills|length and section.skills[i + 1] %}{{ section.skills[i + 1] }}<br>{% endif %}
            </div>
            {% endfor %}
          </div>
          {% elif section.columns == 3 %}
          <div class="skill-columns three-col">
            {% set col1 = [] %}
            {% set col2 = [] %}
            {% set col3 = [] %}
            {% for i in range(0, section.skills|length) %}
              {% if i % 3 == 0 %}
                {% set _ = col1.append(section.skills[i]) %}
              {% elif i % 3 == 1 %}
                {% set _ = col2.append(section.skills[i]) %}
              {% else %}
                {% set _ = col3.append(section.skills[i]) %}
              {% endif %}
            {% endfor %}
            
            <div class="skill-col">
              {% for skill in col1 %}
                {% if skill %}{{ skill }}<br>{% endif %}
              {% endfor %}
            </div>
            <div class="skill-col">
              {% for skill in col2 %}
                {% if skill %}{{ skill }}<br>{% endif %}
              {% endfor %}
            </div>
            <div class="skill-col">
              {% for skill in col3 %}
                {% if skill %}{{ skill }}<br>{% endif %}
              {% endfor %}
            </div>
          </div>
          {% endif %}
        {% else %}
          <div class="skill-list">
            {% for skill in section.skills %}
              {{ skill }}<br>
            {% endfor %}
          </div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>


</section>
{% endif %}
</article>
</article>
